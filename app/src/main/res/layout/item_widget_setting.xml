<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.newagedevs.couplewidgets.view.ui.main.MainViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:orientation="vertical">

        <!-- Section header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_m"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_section_accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Text.SectionTitle"
                    android:text="@string/widget_settings" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_settings_subtitle"
                    android:textColor="?attr/textSecondaryColor"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Romantic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_marginEnd="@dimen/space_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_s">

                <!-- Row 1 — image shape + its color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Field.Column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.FieldLabel"
                            android:text="@string/image_shape" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Field.Romantic"
                            android:onClick="@{viewModel.shapePicker}"
                            android:text="@string/shape"
                            app:drawableStart="@{viewModel.shape}"
                            app:drawableTint="?attr/icon_color" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Field.Column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.FieldLabel"
                            android:text="@string/shape_color" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Field.Romantic"
                            android:onClick="@{viewModel.colorPicker}"
                            android:tag="Shape Color"
                            android:text="@{'#'+Integer.toHexString(viewModel.shapeColor).toUpperCase()}"
                            app:drawableStartCompat="@drawable/ic_color_palette"
                            app:drawableTint="?attr/icon_color"
                            tools:text="#FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Row 2 — symbol + its color -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Field.Column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.FieldLabel"
                            android:text="@string/symbol_shape" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Field.Romantic"
                            android:onClick="@{viewModel.symbolPicker}"
                            android:text="@string/symbol"
                            app:drawableStart="@{viewModel.symbol}"
                            app:drawableTint="?attr/icon_color" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Field.Column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.FieldLabel"
                            android:text="@string/symbol_color" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Field.Romantic"
                            android:onClick="@{viewModel.colorPicker}"
                            android:tag="Symbol Color"
                            android:text="@{'#'+Integer.toHexString(viewModel.symbolColor).toUpperCase()}"
                            app:drawableStartCompat="@drawable/ic_color_palette"
                            app:drawableTint="?attr/icon_color"
                            tools:text="#FF5C8A" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Row 3 — text colors -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/Field.Column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.FieldLabel"
                            android:text="@string/name_color" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Field.Romantic"
                            android:onClick="@{viewModel.colorPicker}"
                            android:tag="Name Color"
                            android:text="@{'#'+Integer.toHexString(viewModel.nameColor).toUpperCase()}"
                            app:drawableStartCompat="@drawable/ic_color_palette"
                            app:drawableTint="?attr/icon_color"
                            tools:text="#FFFFFF" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/Field.Column"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Text.FieldLabel"
                            android:text="@string/counter_color" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/Field.Romantic"
                            android:onClick="@{viewModel.colorPicker}"
                            android:tag="Counter Color"
                            android:text="@{'#'+Integer.toHexString(viewModel.counterColor).toUpperCase()}"
                            app:drawableStartCompat="@drawable/ic_color_palette"
                            app:drawableTint="?attr/icon_color"
                            tools:text="#FFFFFF" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</layout>
