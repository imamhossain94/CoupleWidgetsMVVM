<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="couple"
            type="com.newagedevs.couplewidgets.model.Couple" />

        <variable
            name="background"
            type="android.graphics.drawable.Drawable" />

        <variable
            name="counter"
            type="String" />

    </data>

    <!-- Gradient frame — the card floats inside a rose→orchid border -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_s"
        android:layout_marginEnd="@dimen/space_l"
        android:layout_marginBottom="@dimen/space_s"
        android:background="@drawable/bg_preview_frame"
        android:clickable="true"
        android:focusable="true"
        android:padding="2dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/black"
            app:cardCornerRadius="@dimen/radius_l"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <FrameLayout
                android:id="@+id/previewFrame"
                android:layout_width="match_parent"
                android:layout_height="168dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/system_wallpaper"
                    android:scaleType="centerCrop"
                    app:drawableBackground="@{background}" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="@dimen/space_xxl"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|end"
                        android:layout_weight="2"
                        android:gravity="center|end"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/your_image"
                            app:borderColor="@{couple.frame.color}"
                            app:shape="@{couple.frame.vector}"
                            app:uri="@{couple.you.image}" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="@{couple.you.name}"
                            android:textColor="@{couple.nameColor}"
                            tools:text="Imam" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/space_xs"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:contentDescription="@string/heart_symbol"
                            app:resource="@{couple.heart.vector}"
                            app:tint="@{couple.heart.color}" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="@{counter}"
                            android:textColor="@{couple.counterColor}"
                            android:textSize="18sp"
                            tools:text="1024" />

                        <android.widget.TextClock
                            android:id="@+id/clock"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:alpha="0.7"
                            android:format12Hour="k'h' mm'm' ss's'"
                            android:format24Hour="k'h' mm'm' ss's'"
                            android:gravity="center"
                            android:singleLine="true"
                            android:textColor="@{couple.counterColor}" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center|start"
                        android:layout_weight="2"
                        android:gravity="center|start"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/partner_image"
                            app:borderColor="@{couple.frame.color}"
                            app:shape="@{couple.frame.vector}"
                            app:uri="@{couple.partner.image}" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:text="@{couple.partner.name}"
                            android:textColor="@{couple.nameColor}"
                            tools:text="Aisha" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </com.google.android.material.card.MaterialCardView>

    </FrameLayout>

</layout>
