<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.newagedevs.couplewidgets.view.ui.main.MainViewModel" />

    </data>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/appBackground"
        tools:openDrawer="start">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/appBackground"
            android:orientation="vertical"
            app:toast="@{vm.toast}"
            tools:context=".view.ui.main.MainActivity">

            <!-- ============================================================
                 HERO — gradient app bar + live preview
                 ============================================================ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/bg_bottom_curve"
                android:orientation="vertical"
                android:paddingBottom="@dimen/space_xl">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_m"
                    android:layout_marginEnd="@dimen/space_l"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/menu_button"
                        style="@style/IconButton.Romantic"
                        android:layout_width="@dimen/icon_button_size"
                        android:layout_height="@dimen/icon_button_size"
                        android:contentDescription="@string/menu"
                        android:src="@drawable/ic_menu"
                        app:tint="?attr/icon_color" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_m"
                        android:layout_marginEnd="@dimen/space_m"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/Text.ScreenTitle"
                            android:text="@string/couple_widgets" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:text="@string/tagline"
                            android:textColor="?attr/textSecondaryColor"
                            android:textSize="11sp"
                            android:letterSpacing="0.03" />

                    </LinearLayout>

                    <!-- Primary action: labelled gradient pill, easier to find than a bare icon -->
                    <TextView
                        android:id="@+id/save_button"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/icon_button_size"
                        android:background="@drawable/bg_gradient_cta"
                        android:clickable="true"
                        android:focusable="true"
                        android:contentDescription="@string/save_widget"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center"
                        android:onClick="@{vm.submitData}"
                        android:paddingStart="@dimen/space_l"
                        android:paddingEnd="@dimen/space_xl"
                        android:text="@string/save"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_check"
                        app:drawableTint="@color/white" />

                </LinearLayout>

                <!-- Preview, wrapped in a rose→orchid gradient frame -->
                <FrameLayout
                    android:id="@+id/preview_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_l"
                    android:layout_marginTop="@dimen/space_l"
                    android:layout_marginEnd="@dimen/space_l"
                    android:background="@drawable/bg_preview_frame"
                    android:padding="2dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/previewCardBackground"
                        app:cardCornerRadius="@dimen/radius_l"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <FrameLayout
                            android:id="@+id/previewFrame"
                            android:layout_width="match_parent"
                            android:layout_height="210dp">

                            <ImageView
                                android:id="@+id/bg"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@color/black"
                                android:contentDescription="@string/system_wallpaper"
                                android:scaleType="centerCrop" />

                            <include
                                layout="@layout/item_couple_widget"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:viewModel="@{vm}" />

                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                </FrameLayout>

            </LinearLayout>

            <!-- ============================================================
                 SETTINGS
                 ============================================================ -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/settings_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/space_xxl">

                    <include
                        layout="@layout/item_widget_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:viewModel="@{vm}" />

                    <include
                        layout="@layout/item_widget_style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:viewModel="@{vm}" />

                    <include
                        layout="@layout/item_couple_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:viewModel="@{vm}" />

                    <include
                        layout="@layout/item_date_and_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:viewModel="@{vm}" />

                </LinearLayout>

            </ScrollView>

            <LinearLayout
                android:id="@+id/ads_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_view"
            android:layout_width="288dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?attr/drawerBackground"
            android:fitsSystemWindows="true"
            android:orientation="vertical">

            <include layout="@layout/nav_header" />

            <include layout="@layout/layout_nav_drawer" />

        </LinearLayout>

    </androidx.drawerlayout.widget.DrawerLayout>

</layout>
