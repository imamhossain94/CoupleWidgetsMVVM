<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CoupleWidgets" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/wine_accent</item>
        <item name="colorOnPrimary">@color/dark_rosewood</item>
        <item name="colorPrimaryContainer">@color/wine_gradient_start</item>
        <item name="colorOnPrimaryContainer">@color/wine_text</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/wine_deep</item>
        <item name="colorOnSecondary">@color/wine_text</item>
        <item name="colorSecondaryContainer">@color/dark_rosewood_card</item>
        <item name="colorOnSecondaryContainer">@color/wine_text</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/dark_rosewood</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- App backgrounds -->
        <item name="android:windowBackground">@color/dark_rosewood</item>
        <item name="backgroundColor">@color/dark_rosewood</item>
        <item name="bg_rounded">@drawable/bg_rounded_dark</item>
        <item name="bg_rounded_icon">@drawable/bg_rounded_icon_dark</item>
        <item name="bg_bottom_curve">@drawable/bg_bottom_curve_dark</item>
        <item name="icon_color">@color/wine_icon_tint</item>
        <item name="bg_card">@color/dark_rosewood_card</item>
        <item name="previewCardBackground">@color/dark_rosewood_card</item>

        <!-- Drawer theming -->
        <item name="drawerBackground">@color/dark_rosewood_surface</item>
        <item name="drawerHeaderBackground">@drawable/bg_nav_header_dark</item>
        <item name="drawerItemIconTint">@color/wine_icon_tint</item>
        <item name="drawerItemTextColor">@color/wine_text</item>
        <item name="drawerAccentColor">@color/wine_accent</item>
        <item name="drawerDividerColor">#15C47A8F</item>
        <item name="drawerSectionBackground">@drawable/bg_drawer_section_dark</item>
        <item name="appBackground">@color/dark_rosewood</item>

    </style>

    <style name="ImagePicker.NonFullscreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/dark_rosewood</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/dark_rosewood</item>
    </style>

</resources>